#backend/.env
# =========================
# SERVER
# =========================
NODE_ENV=debug
PORT=5000

# =========================
# DATABASE (Render Postgres - External URL)
# IMPORTANT: add sslmode=require
# =========================
DATABASE_URL=postgresql://postgres:vr123456@localhost:5432/cemetery_db

# =========================
# JWT
# =========================
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# =========================
# CORS
# Put your frontend URL here (Render static site or custom domain)
# Keep localhost for local testing if needed.
# =========================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR-FRONTEND.onrender.com
